{
  "protocol": {
    "name": "Controlled ASL CBF/ATT 4-PLD Parameter Estimation Benchmark",
    "description": "Rigorous reproducibility and model comparison benchmark across classical, supervised DNN, and reinforcement learning estimators.",
    "date": "2026-10-14",
    "plds_sec": [1.525, 2.025, 2.525, 3.025],
    "lds_sec": [1.8, 1.8, 1.8, 1.8],
    "num_plds": 4,

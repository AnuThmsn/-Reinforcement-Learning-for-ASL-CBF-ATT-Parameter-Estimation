    },
    "GRID31_LM": {
      "family": "Classical Continuous Nonlinear Least Squares",
      "configuration": "31x31 coarse grid initialization followed by 5 Levenberg-Marquardt analytical Jacobian steps",
      "is_learned": false,
      "training_time_sec": 0.0,
      "training_samples": 0
    },
    "DNN_BOUNDED": {
      "family": "Supervised Deep Neural Network",
      "configuration": "BoundedNet (4 hidden layers x 64 neurons, ELU, physical sigmoid output bounds)",
      "is_learned": true,
      "training_epochs": 25,
      "batch_size": 256,
      "training_samples": 100000,
      "optimizer": "Adam",
      "learning_rate": 0.001
    },
    "SAC_PURE": {
      "family": "Deep Reinforcement Learning (Pure SAC)",
      "configuration": "Soft Actor-Critic, GaussianPolicy(256x256), TwinCritic(256x256), 12 iterative steps, random init, no LM",
